# Preferred: sign in as your Supabase admin user (RLS stays active).
SUPABASE_ADMIN_EMAIL=your-admin-email@example.com
SUPABASE_ADMIN_PASSWORD=your-admin-password

# Alternative: use a rotated service/secret key instead of email+password.
# Leave it commented out unless you really need it.
# SUPABASE_SERVICE_KEY=sb_secret_...

# Appwrite source (defaults are already set in the script)
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=68ed8a8f0032cd3c025c
APPWRITE_DATABASE_ID=68ed8ab9002eb2e1dbf8
APPWRITE_COLLECTION_ID=projects
APPWRITE_BUCKET_ID=68ed8c6f00079b6e068e

